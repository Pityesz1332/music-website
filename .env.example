# Public Swarm gateway used for reads + audio/cover playback (all visitors).
# Required for a public deployment (the localhost fallback won't work publicly).
# Must be HTTPS if the site is served over HTTPS/bzz (mixed-content rules).
VITE_SWARM_READ_URL=https://your-public-bee-gateway.example

# The admin's own WRITABLE Bee node (holds a postage batch) used for uploads and
# feed publishing. Only meaningful in the admin's browser. NOT secret (a URL).
VITE_SWARM_WRITE_URL=http://localhost:1633

# Ethereum address that OWNS the song-catalog feed (readers resolve the feed
# from this address). The runtime-entered feed publisher private key MUST derive
# to this exact address, or published songs won't be visible to readers.
VITE_FEED_OWNER_ADDRESS=0xYourFeedOwnerAddress

# Allow-listed admin wallet address(es) for Sign-In-With-Ethereum admin login.
# Comma-separate multiple addresses. If unset, no wallet can sign in.
VITE_ADMIN_ADDRESS=0xYourAdminWalletAddress