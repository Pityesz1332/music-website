# PUBLIC config — safe to set in the deployed (Vercel) build.

# Public Swarm read gateway (visitors fetch assets + catalog through this).
VITE_SWARM_GATEWAY=https://gateway.ethswarm.org

# Shared song-catalog feed identity (both are public and safe to ship).
# OWNER = the Ethereum address that owns the catalog feed.
# TOPIC = a fixed label for the feed.
VITE_SWARM_FEED_OWNER=
VITE_SWARM_FEED_TOPIC=dj-enez-song-catalog

# Comma-separated wallet address(es) allowed to sign in as admin.
VITE_ADMIN_ADDRESSES=

# Optional: static fallback catalog reference (used only if the feed can't be resolved).
VITE_SWARM_SONGS_REF=


# ADMIN-LOCAL ONLY — DO NOT set these in the public deployment.
# These are write credentials for a funded Swarm resource and get baked into the
# client bundle. Set them only when running locally to publish, against a Bee node
# that is NOT publicly reachable (and whose CORS allowlist is just your local origin,
# never "*"). The feed PRIVATE KEY is entered at runtime in the admin panel and is
# never stored here or in the bundle.
VITE_SWARM_BEE_API=
VITE_SWARM_POSTAGE_BATCH=
